# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Get a key at https://aistudio.google.com/apikey
#
# These variables are read ONLY by the server-side /api/hint endpoint.
# Do NOT prefix them with VITE_ (that would expose the key to the browser bundle).

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model name (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: upstream request timeout in milliseconds (default: 20000)
# GEMINI_TIMEOUT_MS=20000
